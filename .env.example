# Для автоматического создания .env: node scripts/setup.js
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
DOMAIN=localhost
PORT=3000
TRUST_PROXY=0
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nexcent
DB_USER=nexcent
DB_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ANOTHER_RANDOM_PASSWORD
SEED_DEMO_REVIEWS=true

# Реальные реквизиты для HTML и скачиваемой политики; существующую .env не заменяйте.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_ADDRESS=
LEGAL_CONTACT_EMAIL=
